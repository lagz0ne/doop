new file mode 100644
index 0000000..20684d0
--- /dev/null
+++ b/shared/renderTrial.ts
@@ -0,0 +1,54 @@
+/**
+ * The render trial's vocabulary, shared by the browser that measures
+ * (src/lib/renderTrial.ts) and the server that forwards its reports to an
+ * OpenTelemetry collector (server/telemetry.ts). The report's schema is in
+ * renderTrialSchema.ts, apart, so the editor's bundle does not carry zod.
+ *
+ */
+
+export const TRIAL_FACTORS = ['gpu', 'zoomPictures'] as const
+export type TrialFactor = (typeof TRIAL_FACTORS)[number]
+
+export const TRIAL_LEVELS = ['off', 'on'] as const
+export type TrialLevel = (typeof TRIAL_LEVELS)[number]
+
+/** Why a factor has the level it has on this page load:
+ *  explore - the trial is still sampling both levels;
+ *  exploit - the trial has a winner and uses it;
+ *  epsilon - the trial has a winner and took the other level this once;
+ *  override - an explicit localStorage key set it;
+ *  ineligible - this browser cannot have it on (no hardware WebGL2, or the layer failed);
+ *  off - the trial is switched off, or its storage is unusable. */
+export const TRIAL_REASONS = ['explore', 'exploit', 'epsilon', 'override', 'ineligible', 'off'] as const
+export type TrialReason = (typeof TRIAL_REASONS)[number]
+
+export const GESTURE_KINDS = ['pan', 'zoom'] as const
+export type GestureKind = (typeof GESTURE_KINDS)[number]
+
+/** heavy: at least HEAVY_CULLED culled frames (shells or pictures) were in
+ *  view when the gesture started; light: fewer. */
+export const STRATA = ['light', 'heavy'] as const
+export type Stratum = (typeof STRATA)[number]
+
+export const FRAME_BUCKETS = ['<20', '20-49', '50-99', '100-199', '200+'] as const
+export type FrameBucket = (typeof FRAME_BUCKETS)[number]
+
+export function frameBucket(frames: number): FrameBucket {
+  if (frames < 20) return '<20'
+  if (frames < 50) return '20-49'
+  if (frames < 100) return '50-99'
+  if (frames < 200) return '100-199'
+  return '200+'
+}
+
+/** The 2x2 cell: A neither experiment, B the GPU layer, C both, D zoom pictures only. */
+export type TrialArm = 'A' | 'B' | 'C' | 'D'
+export function armOf(gpu: TrialLevel, zoomPictures: TrialLevel): TrialArm {
+  if (gpu === 'on') return zoomPictures === 'on' ? 'C' : 'B'
+  return zoomPictures === 'on' ? 'D' : 'A'
+}
+
+export const RENDER_REPORT_VERSION = 1
+/** The body limit of the telemetry route; a full report is about 2 KB. */
+export const RENDER_REPORT_MAX_BYTES = 8 * 1024
+export const RENDERER_MAX_CHARS = 80
diff --git a/shared/renderTrialSchema.ts b/shared/renderTrialSchema.ts
new file mode 100644
index 0000000..4a1c1b9
--- /dev/null
+++ b/shared/renderTrialSchema.ts
@@ -0,0 +1,102 @@
+import { z } from 'zod'
+import {
+  FRAME_BUCKETS,
+  GESTURE_KINDS,
+  RENDERER_MAX_CHARS,
+  RENDER_REPORT_VERSION,
+  STRATA,
+  TRIAL_LEVELS,
+  TRIAL_REASONS,
+} from './renderTrial.ts'
+
+/**
+ * The render trial's report: what one browser measured while the camera
+ * moved, and which of the two render experiments it had on. The browser
+ * builds it (src/lib/renderTrial.ts), the server validates it here and
+ * forwards it (server/telemetry.ts). The browser imports only the types.
+ *
+ * Nothing in it names a person, a canvas or a frame: the trial needs the arm,
+ * the device class and the frame timings, and nothing else leaves the
+ * browser. Counts in `rows` cover only the time since the previous report of
+ * the same page load, so summing rows across reports never counts a frame
+ * twice.
+ */
+
+const count = z.number().int().min(0).max(10_000_000)
+const ms = z.number().finite().min(0).max(1000)
+const share = z.number().finite().min(0).max(1)
+const level = z.enum(TRIAL_LEVELS)
+
+const factor = z.object({ level, reason: z.enum(TRIAL_REASONS) }).strict()
+
+const row = z
+  .object({
+    kind: z.enum(GESTURE_KINDS),
+    stratum: z.enum(STRATA),
+    /* a live document was in view when the gesture started */
+    live: z.boolean(),
+    gestures: count,
+    frames: count,
+    slow: count,
+    mean: ms,
+    p95: ms,
+  })
+  .strict()
+  .refine((r) => r.slow <= r.frames, { message: 'more slow frames than frames' })
+
+/** The trial's current leaning for one factor in this browser; winner null
+ *  while it is still exploring. Shares are null while a level has no frames. */
+const verdict = z
+  .object({
+    winner: level.nullable(),
+    onShare: share.nullable(),
+    offShare: share.nullable(),
+    onFrames: count,
+    offFrames: count,
+    onLoads: count,
+    offLoads: count,
+  })
+  .strict()
+
+const environment = z
+  .object({
+    /* the unmasked WebGL renderer, truncated; printable ASCII only, so a log
+       line never carries control characters */
+    renderer: z
+      .string()
+      .max(RENDERER_MAX_CHARS)
+      .regex(/^[\x20-\x7e]*$/),
+    /* hardware WebGL2 without a major performance caveat; null = not probed */
+    hardware: z.boolean().nullable(),
+    dpr: z.number().finite().min(0.1).max(10),
+    /* the window, rounded to 100 px */
+    width: z.number().int().min(0).max(20_000),
+    height: z.number().int().min(0).max(20_000),
+    cores: z.number().int().min(1).max(1024).nullable(),
+    memory: z.number().finite().min(0).max(1024).nullable(),
+    /* the estimated display refresh interval, ms */
+    display: z.number().finite().min(1).max(100),
+    touch: z.boolean(),
+    frames: z.enum(FRAME_BUCKETS),
+  })
+  .strict()
+
+export const renderReportSchema = z
+  .object({
+    v: z.literal(RENDER_REPORT_VERSION),
+    epoch: z.number().int().min(0).max(1_000_000),
+    gpu: factor,
+    zoomPictures: factor,
+    env: environment,
+    rows: z
+      .array(row)
+      .min(1)
+      .max(GESTURE_KINDS.length * STRATA.length * 2),
+    verdicts: z.object({ gpu: verdict, zoomPictures: verdict }).strict(),
+  })
+  .strict()
+
+export type RenderReport = z.infer<typeof renderReportSchema>
+export type RenderReportRow = RenderReport['rows'][number]
+export type RenderVerdict = RenderReport['verdicts']['gpu']
+export type RenderEnvironment = RenderReport['env']
