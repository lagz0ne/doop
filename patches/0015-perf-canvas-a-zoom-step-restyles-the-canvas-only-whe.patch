+
+/* Chrome drawn inside the world at a fixed screen size (frame names, rings,
+   grips, pins) undoes the camera's zoom through the --zoom custom property.
+   The property is inherited, so every write restyles each element under the
+   stage and re-lays out and repaints whatever reads it: on a page of 188
+   frames, 10-13 ms of style for ~1550 elements plus the paint and commit of
+   every frame name, on each step of a zoom. A zoom that only moves the
+   world's transform costs none of that. So while the camera is moving the
+   property follows it in steps: it is rewritten once the zoom has drifted
+   this far from the value last written, and exactly when the camera rests.
+   In between, that chrome is off its screen size by at most the drift. */
+export const CHROME_ZOOM_DRIFT = 1.1
+
+/** True when the zoom last written for the world's chrome is too far from
+ *  the camera's to leave standing while it moves. */
+export function chromeZoomStale(written: number | null, zoom: number, drift = CHROME_ZOOM_DRIFT): boolean {
+  if (written === null || !(written > 0) || !(zoom > 0)) return true
+  const ratio = zoom > written ? zoom / written : written / zoom
+  return ratio > drift
+}
diff --git a/tests/chromeZoom.test.ts b/tests/chromeZoom.test.ts
new file mode 100644
index 0000000..81c6ee4
--- /dev/null
+++ b/tests/chromeZoom.test.ts
@@ -0,0 +1,32 @@
+import { describe, expect, it } from 'vitest'
+import { CHROME_ZOOM_DRIFT, chromeZoomStale } from '../src/lib/layoutZoom'
+
+/* The --zoom the world's chrome is sized by follows a moving camera in
+   steps (layoutZoom.ts): a write restyles the whole canvas. */
+describe('chromeZoomStale', () => {
+  it('leaves a zoom within the drift standing, in either direction', () => {
+    expect(chromeZoomStale(1, 1)).toBe(false)
+    expect(chromeZoomStale(1, 1.05)).toBe(false)
+    expect(chromeZoomStale(1, 0.95)).toBe(false)
+    expect(chromeZoomStale(0.5, 0.5 * CHROME_ZOOM_DRIFT * 0.999)).toBe(false)
+    expect(chromeZoomStale(0.5, (0.5 / CHROME_ZOOM_DRIFT) * 1.001)).toBe(false)
+  })
+
+  it('asks for a write once the camera has drifted past it', () => {
+    expect(chromeZoomStale(1, 1.2)).toBe(true)
+    expect(chromeZoomStale(1, 0.8)).toBe(true)
+    expect(chromeZoomStale(0.08, 0.6)).toBe(true)
+    expect(chromeZoomStale(8, 8 * CHROME_ZOOM_DRIFT * 1.001)).toBe(true)
+  })
+
+  it('always writes when nothing usable was written yet', () => {
+    expect(chromeZoomStale(null, 1)).toBe(true)
+    expect(chromeZoomStale(0, 1)).toBe(true)
+    expect(chromeZoomStale(Number.NaN, 1)).toBe(true)
+  })
+
+  it('takes the drift it is given', () => {
+    expect(chromeZoomStale(1, 1.05, 1.02)).toBe(true)
+    expect(chromeZoomStale(1, 1.05, 1.5)).toBe(false)
+  })
+})
