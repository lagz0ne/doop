From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jim Keeney <jim.keeney@ttalks.show>
Date: Sun, 15 Nov 2026 05:53:23 +0000
Subject: [PATCH 30/32] feat(agents): a switch to keep agents from writing
 style guides (AGENT_GUIDELINE_WRITES)

Style guides are injected into the resident agent's system prompt and read by
every connected agent as rules to execute, so an agent that writes one can
plant instructions every later run inherits. With AGENT_GUIDELINE_WRITES=false
the set_guidelines tool (MCP and resident) refuses and points to a comment;
people still write guides through the UI and accept the distiller's
proposals. Default true keeps the current behaviour.

Carried from kgoedecke/doop#505 (08957e7, with the server and .env.example
parts of its fixups 6818059) until upstream releases it.
---
 .env.example       | 5 +++++
 server/env.ts      | 6 ++++++
 server/mcp.ts      | 4 ++++
 server/resident.ts | 4 ++++
 4 files changed, 19 insertions(+)

diff --git a/.env.example b/.env.example
index fbcc5c5..5dd2cf1 100644
--- a/.env.example
+++ b/.env.example
@@ -230,6 +230,11 @@
 # subscription from a third-party server is outside OpenAI's terms and can get
 # an account rate-limited — the API-key path is the supported alternative.
 #CHATGPT_CONNECT_DISABLED=
+
+# Whether agents (MCP tools and the built-in agent) may create or replace canvas
+# style guides. Guides are injected into the agent's system prompt as rules to
+# follow, so on a shared instance set this to false and let people write them.
+#AGENT_GUIDELINE_WRITES=true
 # OAuth client for the ChatGPT flow. Defaults to the Codex CLI's public client,
 # whose only registered redirect is the loopback URL below.
 #CHATGPT_OAUTH_CLIENT_ID=
diff --git a/server/env.ts b/server/env.ts
index b5d93e8..593af06 100644
--- a/server/env.ts
+++ b/server/env.ts
@@ -195,6 +195,12 @@ const schema = {
      echoes the worker secrets it contains */
   DOOP_GEMINI_CLOUD_WORKERS: str({ default: undefined }),
   CHATGPT_CONNECT_DISABLED: bool({ default: false }),
+  /* Canvas style guides ride in the resident agent's system prompt and are read
+     by every connected agent as rules to execute. When false, only people may
+     write them (the REST route and the distiller's proposals, which a person
+     accepts); the set_guidelines tool refuses for agents, so a prompt-injected
+     agent cannot plant instructions every later run inherits. */
+  AGENT_GUIDELINE_WRITES: bool({ default: true }),
   CHATGPT_OAUTH_ISSUER: origin({ default: 'https://auth.openai.com' }),
   CHATGPT_OAUTH_CLIENT_ID: str({ default: 'app_EMoamEEZ73f0CkXaXp7hrann' }),
   CHATGPT_OAUTH_REDIRECT_URI: str({ default: 'http://localhost:1455/auth/callback' }),
diff --git a/server/mcp.ts b/server/mcp.ts
index 0b28080..502258d 100644
--- a/server/mcp.ts
+++ b/server/mcp.ts
@@ -708,6 +708,10 @@ export function buildMcpServer(
     },
     async ({ canvas_id, name, markdown, title, agent_name }) => {
       if (!canvasFor(canvas_id, 'edit')) return noCanvas(canvas_id)
+      if (!env.AGENT_GUIDELINE_WRITES)
+        return err(
+          'style guides on this instance are written by people (AGENT_GUIDELINE_WRITES=false); propose the change in a comment instead',
+        )
       const actor = actorFrom(agent_name)
       try {
         const doc = actions.setGuideline(canvas_id, name, markdown, actor, undefined, title)
diff --git a/server/resident.ts b/server/resident.ts
index 10d0467..a9f5d89 100644
--- a/server/resident.ts
+++ b/server/resident.ts
@@ -2096,6 +2096,10 @@ export async function execTool(
         return saved.ok ? ok('sent to the Doop team — carry on with the task') : fail(saved.error)
       }
       case 'set_guidelines': {
+        if (!env.AGENT_GUIDELINE_WRITES)
+          return fail(
+            'style guides on this instance are written by people (AGENT_GUIDELINE_WRITES=false); propose the change in a comment instead',
+          )
         const raw = block.input as { name?: string; markdown?: string; title?: string }
         if (typeof raw.name !== 'string' || !raw.name.trim()) return fail('name must be a non-empty slug')
         if (typeof raw.markdown !== 'string') return fail('markdown must be a string (empty string deletes the doc)')
