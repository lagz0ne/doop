diff --git a/src/lib/fullUi.ts b/src/lib/fullUi.ts
new file mode 100644
index 0000000..d77c606
--- /dev/null
+++ b/src/lib/fullUi.ts
@@ -0,0 +1,19 @@
+/**
+ * This build runs for one person and their agents, so the chrome for the
+ * rest of the product is put away: workspaces, sharing, the community,
+ * automations, integrations, webhooks, the plan line and the help menu.
+ *
+ * Only the ways in are hidden. The pages still open by their URL and the
+ * server is untouched, so nothing here is a permission.
+ *
+ * `localStorage['doop:full-ui'] = 'on'` (then reload) brings it all back.
+ */
+function readFullUi(): boolean {
+  try {
+    return localStorage.getItem('doop:full-ui') === 'on'
+  } catch {
+    return false
+  }
+}
+
+export const FULL_UI = readFullUi()
