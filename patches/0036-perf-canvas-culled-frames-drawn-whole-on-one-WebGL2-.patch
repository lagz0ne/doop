diff --git a/src/components/StagePictures.tsx b/src/components/StagePictures.tsx
new file mode 100644
index 0000000..70aa56b
--- /dev/null
+++ b/src/components/StagePictures.tsx
@@ -0,0 +1,351 @@
+import { useEffect, useRef, useState, type RefObject } from 'react'
+import type { Frame } from '../../shared/types'
+import { useStore } from '../lib/store'
+import { isCanvasElement } from '../lib/drawing'
+import { isSyncedFrame } from '../lib/sync'
+import { isGithubFrame } from '../lib/github'
+import { cullingEnabled, useLiveFrames } from '../lib/liveFrames'
+import { NameAtlas, type NameStyle } from '../lib/gpuLabels'
+import {
+  PictureRenderer,
+  frameAt,
+  gpuDrawnFrames,
+  gpuMode,
+  nameStrip,
+  pictureSrc,
+  setGpuHitTest,
+  useGpuPictures,
+  type Picture,
+  type PictureFrame,
+} from '../lib/gpuPictures'
+
+const NONE: ReadonlySet<string> = new Set()
+
+type Candidate = PictureFrame & { updatedAt: number }
+
+/** The name as the title shows it: white space collapsed, none at the ends. */
+const shownName = (name: string) => name.replace(/[\t\n\f\r ]+/g, ' ').trim()
+
+function framesOf(frames: readonly Frame[]): Candidate[] {
+  return frames.map((f) => {
+    const element = isCanvasElement(f.html)
+    return {
+      id: f.id,
+      x: f.x,
+      y: f.y,
+      width: f.width,
+      height: f.height,
+      rotation: f.rotation,
+      updatedAt: f.updatedAt,
+      hidden: f.hidden,
+      /* the title of these holds more than the name (a lock, a mark, the
+         review badge), or the shell shows something no picture does */
+      candidate:
+        !!f.html &&
+        !element &&
+        !f.hidden &&
+        !f.locked &&
+        !f.approval &&
+        !isSyncedFrame(f.html) &&
+        !isGithubFrame(f.html),
+      label: element ? '' : shownName(f.name),
+    }
+  })
+}
+
+/** A CSS colour as rgba (0-255, alpha 0-1), through a canvas, which parses
+ *  every colour syntax the page may use (color-mix, oklch). */
+function rgba(color: string): [number, number, number, number] {
+  const c = document.createElement('canvas')
+  c.width = c.height = 1
+  const ctx = c.getContext('2d', { willReadFrequently: true })
+  if (!ctx) return [0, 0, 0, 0]
+  ctx.fillStyle = color
+  ctx.fillRect(0, 0, 1, 1)
+  const [r = 0, g = 0, b = 0, a = 0] = ctx.getImageData(0, 0, 1, 1).data
+  return [r, g, b, a / 255]
+}
+
+/**
+ * The Stage's GPU canvas (gpuPictures.ts), under the frame stack: draws the
+ * culled frames it can stand in for, pictures, names and the hover ring, and
+ * takes them out of the DOM through `useGpuPictures`; a press on one is
+ * resolved here (`setGpuHitTest`) for the Stage to wake it. Renders nothing
+ * unless `doop:gpu` asks for it and culling is on (with culling off every
+ * frame is live, and there is nothing to draw).
+ */
+export function StagePictures({
+  frames,
+  stage,
+}: {
+  frames: readonly Frame[]
+  stage: RefObject<HTMLDivElement | null>
+}) {
+  const [mode] = useState(gpuMode)
+  const [on] = useState(() => mode !== 'off' && cullingEnabled())
+  const canvasRef = useRef<HTMLCanvasElement>(null)
+  const probeRef = useRef<HTMLDivElement>(null)
+  const textRef = useRef<HTMLSpanElement>(null)
+  const markRef = useRef<HTMLSpanElement>(null)
+  const ringRef = useRef<HTMLSpanElement>(null)
+  const control = useRef<{ setFrames(frames: readonly Frame[]): void } | null>(null)
+  const framesRef = useRef(frames)
+
+  useEffect(() => {
+    const canvas = canvasRef.current
+    const el = stage.current
+    const probe = probeRef.current
+    const text = textRef.current
+    const mark = markRef.current
+    const ringProbe = ringRef.current
+    if (!on || !canvas || !el || !probe || !text || !mark || !ringProbe) return
+    let all = framesOf(framesRef.current)
+    let lost = false
+    let drawnList: Candidate[] = []
+    const renderer = PictureRenderer.create(canvas, mode, {
+      lost(isLost) {
+        lost = isLost
+        update()
+      },
+      textures: () => update(),
+    })
+    if (!renderer) return
+    const atlas = new NameAtlas()
+    let style: NameStyle | null = null
+    let styleKey = ''
+    let atlasKey = ''
+    /* the names the atlas was last built from */
+    let tried = new Set<string>()
+    let fontAsked = ''
+    let lastZoom = NaN
+
+    /* The title's look, read off a hidden element styled as it is: the
+       theme's colour, the web font, the line the title sits on. */
+    function restyle() {
+      if (!probe || !text || !mark || !ringProbe) return
+      const cs = getComputedStyle(text)
+      const font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`
+      const box = probe.getBoundingClientRect()
+      const next: NameStyle = {
+        font,
+        letterSpacing: cs.letterSpacing === 'normal' ? '0px' : cs.letterSpacing,
+        color: cs.color,
+        lineHeight: box.height,
+        baseline: mark.getBoundingClientRect().top - box.top,
+      }
+      const dpr = window.devicePixelRatio || 1
+      const key = `${next.font}|${next.letterSpacing}|${next.color}|${next.lineHeight}|${next.baseline}|${dpr}`
+      /* drawn in a fallback font, the names would stay so: wait for the
+         page's own (once; a font that never comes is not waited for) */
+      if (fontAsked !== font && !document.fonts.check(font)) {
+        fontAsked = font
+        document.fonts.load(font).then(restyle, restyle)
+      }
+      const ring = getComputedStyle(ringProbe).color
+      renderer!.setLabels(atlas.style ? atlas : null, rgba(ring))
+      if (key === styleKey) return
+      styleKey = key
+      style = next
+      atlasKey = ''
+      update()
+    }
+
+    /* Draws the names into the atlas when one is missing from it, or the
+       look changed. A name that did not fit keeps its frame in the DOM. */
+    function ensureAtlas() {
+      if (!style) return
+      let missing = atlasKey !== styleKey
+      if (!missing) for (const f of all) if (f.candidate && f.label && !tried.has(f.label)) missing = true
+      if (!missing) return
+      const names = new Set<string>()
+      for (const f of all) if (f.candidate && f.label) names.add(f.label)
+      atlas.build(names, style, window.devicePixelRatio || 1, renderer!.maxTextureSide)
+      tried = names
+      atlasKey = styleKey
+      renderer!.setLabels(atlas, rgba(getComputedStyle(ringProbe!).color))
+    }
+
+    function update() {
+      if (!renderer) return
+      const live = useLiveFrames.getState()
+      const s = useStore.getState()
+      const ids = live.ids
+      if (lost || ids === null || !style) {
+        drawnList = []
+        renderer.setScene([])
+        useGpuPictures.getState().setDrawn(NONE)
+        return
+      }
+      const selected = new Set(s.selectedIds)
+      /* what FrameSlot draws as a FrameView (or HiddenFrameView, selected) */
+      const inDom = (id: string) => selected.has(id) || ids.has(id) || live.woken.includes(id) || !!s.streams[id]
+      ensureAtlas()
+      const pictures: Picture[] = []
+      for (const f of all)
+        if (f.candidate)
+          pictures.push({
+            id: f.id,
+            x: f.x,
+            y: f.y,
+            width: f.width,
+            height: f.height,
+            src: pictureSrc(f, live.previewDensity, live.sharp),
+            later: inDom(f.id),
+          })
+      renderer.setPictures(pictures)
+      lastZoom = s.viewport.zoom
+      const strip = nameStrip(style.lineHeight, lastZoom)
+      const drawn = gpuDrawnFrames(
+        all,
+        inDom,
+        (f) => renderer.hasPicture(f.id) && (!f.label || atlas.cells.has(f.label)),
+        strip,
+      )
+      drawnList = all.filter((f) => drawn.has(f.id))
+      /* the canvas first, in this same task, then the DOM: a frame that
+         leaves it finds itself already drawn in its place */
+      renderer.setScene(drawnList)
+      renderer.drawNow()
+      useGpuPictures.getState().setDrawn(drawn)
+    }
+
+    /* where the stage's content starts on screen: read on a press, and kept
+       for the hover, which must not force a layout on every move */
+    let origin = { left: 0, top: 0 }
+    function readOrigin() {
+      if (!el) return origin
+      const r = el.getBoundingClientRect()
+      origin = { left: r.left + el.clientLeft, top: r.top + el.clientTop }
+      return origin
+    }
+
+    /* the drawn frame under a pointer event, or null off the empty stage */
+    function pageAt(e: { clientX: number; clientY: number; target: EventTarget | null }, at = origin) {
+      if (!el || !style || !drawnList.length) return null
+      const t = e.target
+      if (t !== el && !(t instanceof Element && t.classList.contains('world'))) return null
+      const vp = useStore.getState().viewport
+      const x = (e.clientX - at.left - vp.x) / vp.zoom
+      const y = (e.clientY - at.top - vp.y) / vp.zoom
+      return frameAt(drawnList, x, y, vp.zoom, style.lineHeight)
+    }
+
+    setGpuHitTest((e) => pageAt(e, readOrigin())?.id ?? null)
+
+    /* the shell's hover ring, for a mouse resting over a drawn frame's box */
+    let pointer: PointerEvent | null = null
+    function hover(e: PointerEvent | null) {
+      pointer = e
+      const hit = e && e.pointerType !== 'touch' && e.buttons === 0 ? pageAt(e) : null
+      renderer!.setHover(hit && !hit.name ? hit.id : null)
+    }
+    const onMove = (e: PointerEvent) => hover(e)
+    const onLeave = () => hover(null)
+    el.addEventListener('pointermove', onMove, { passive: true })
+    el.addEventListener('pointerleave', onLeave)
+    el.addEventListener('pointerdown', onLeave, true)
+
+    function measure() {
+      if (!renderer || !el) return
+      renderer.setStage({ width: el.clientWidth, height: el.clientHeight }, window.devicePixelRatio || 1)
+      readOrigin()
+    }
+
+    /* Names are cut at the frame's width and kept a set size on screen, so
+       what the canvas may draw beside DOM frames changes with the zoom: it
+       is worked out again once the camera rests, not per frame. */
+    let rest = 0
+    function camera(vp: { x: number; y: number; zoom: number }) {
+      renderer!.setCamera(vp)
+      window.clearTimeout(rest)
+      rest = window.setTimeout(() => {
+        if (useStore.getState().viewport.zoom !== lastZoom) update()
+        if (pointer) hover(pointer)
+      }, 150)
+    }
+
+    renderer.setCamera(useStore.getState().viewport)
+    measure()
+    restyle()
+    update()
+    control.current = {
+      setFrames(next) {
+        all = framesOf(next)
+        update()
+      },
+    }
+    const unLive = useLiveFrames.subscribe(update)
+    const unStore = useStore.subscribe((s, prev) => {
+      if (s.viewport !== prev.viewport) camera(s.viewport)
+      if (s.selectedIds !== prev.selectedIds || s.streams !== prev.streams) update()
+    })
+    const resize = new ResizeObserver(measure)
+    resize.observe(el)
+    /* the theme flips classes and custom properties on the root */
+    const theme = new MutationObserver(restyle)
+    theme.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'style'] })
+    document.fonts.addEventListener('loadingdone', restyle)
+    /* a window moved to a screen of another density */
+    let dpr = window.matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`)
+    const onDpr = () => {
+      dpr.removeEventListener('change', onDpr)
+      dpr = window.matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`)
+      dpr.addEventListener('change', onDpr)
+      measure()
+      restyle()
+    }
+    dpr.addEventListener('change', onDpr)
+    return () => {
+      control.current = null
+      setGpuHitTest(null)
+      window.clearTimeout(rest)
+      unLive()
+      unStore()
+      resize.disconnect()
+      theme.disconnect()
+      document.fonts.removeEventListener('loadingdone', restyle)
+      dpr.removeEventListener('change', onDpr)
+      el.removeEventListener('pointermove', onMove)
+      el.removeEventListener('pointerleave', onLeave)
+      el.removeEventListener('pointerdown', onLeave, true)
+      renderer.dispose()
+      useGpuPictures.getState().setDrawn(NONE)
+    }
+  }, [on, mode, stage])
+
+  useEffect(() => {
+    framesRef.current = frames
+    control.current?.setFrames(frames)
+  }, [frames])
+
+  if (!on) return null
+  return (
+    <>
+      <canvas ref={canvasRef} data-stage-pictures="" className="pointer-events-none absolute inset-0 h-full w-full" />
+      {/* styled as a frame's title (FrameShell), for the names drawn above */}
+      <div
+        ref={probeRef}
+        aria-hidden
+        style={{
+          position: 'absolute',
+          left: 0,
+          top: 0,
+          visibility: 'hidden',
+          pointerEvents: 'none',
+          display: 'flex',
+          alignItems: 'center',
+          whiteSpace: 'nowrap',
+          fontSize: 12,
+          fontWeight: 600,
+          color: 'var(--ink-soft)',
+        }}
+      >
+        <span ref={textRef}>
+          Hg
+          <span ref={markRef} style={{ display: 'inline-block', width: 0, height: 0 }} />
+        </span>
+        <span ref={ringRef} style={{ color: 'color-mix(in srgb, var(--brand) 55%, transparent)' }} />
+      </div>
+    </>
+  )
+}
diff --git a/src/lib/gpuLabels.ts b/src/lib/gpuLabels.ts
new file mode 100644
index 0000000..7bfcf92
--- /dev/null
+++ b/src/lib/gpuLabels.ts
@@ -0,0 +1,177 @@
+/* Frame names for the GPU picture layer (gpuPictures.ts), as one texture.
+
+   A frame drawn on the Stage's canvas has no element at all, so its name is
+   drawn there too: each distinct name is rendered once, with the font and
+   colour the FrameShell's title has (read off a probe element in the stage,
+   so the theme and the web font are the page's own), into one 2D canvas at
+   the screen's density, and that canvas is the atlas the GL pass samples.
+
+   The name keeps its size on screen at every zoom, so only where it is cut
+   changes with the zoom: the DOM title is the frame's width on screen and
+   ends in an ellipsis when the name is longer. For that each cell carries
+   the width of every prefix of its name, measured once, and a draw picks
+   the longest prefix that leaves room for the ellipsis (`ellipsisCut`), the
+   rule text-overflow follows. Nothing is measured or rendered while the
+   camera moves. */
+
+/** The title's look, read off the probe (StagePictures). */
+export interface NameStyle {
+  /** the canvas `font` shorthand: style, weight, size, family */
+  font: string
+  letterSpacing: string
+  /** the computed CSS colour of the name */
+  color: string
+  /** the title row's height, CSS px */
+  lineHeight: number
+  /** the baseline below the row's top, CSS px */
+  baseline: number
+}
+
+/** One name in the atlas. */
+export interface NameCell {
+  /** the cell in the atlas, device px; the text starts PAD px in */
+  x: number
+  y: number
+  width: number
+  height: number
+  /** the name's advance, CSS px */
+  advance: number
+  /** prefix[k]: the advance of the first k graphemes, CSS px (k = 0…count) */
+  prefix: Float32Array
+  count: number
+}
+
+/** Device px around each cell's text, for ink outside the advance. */
+export const PAD = 2
+
+/** The atlas side, device px, unless the GPU allows less. */
+const ATLAS_SIDE = 4096
+
+const segmenter = typeof Intl !== 'undefined' && 'Segmenter' in Intl ? new Intl.Segmenter() : null
+
+function graphemeEnds(text: string): number[] {
+  if (!segmenter) return Array.from(text, (_, i) => i + 1)
+  const ends: number[] = []
+  for (const s of segmenter.segment(text)) ends.push(s.index + s.segment.length)
+  return ends
+}
+
+/**
+ * How many graphemes of a name to keep before the ellipsis for it to fit in
+ * `width` (CSS px), or -1 when the whole name fits and no ellipsis is drawn.
+ * As text-overflow does: the longest prefix that leaves room for the
+ * ellipsis, down to none (the ellipsis alone, clipped if even it is wider).
+ */
+export function ellipsisCut(prefix: ArrayLike<number>, count: number, ellipsis: number, width: number): number {
+  if ((prefix[count] ?? 0) <= width) return -1
+  const room = width - ellipsis
+  /* the prefixes grow with k: the last one that fits */
+  let lo = 0
+  let hi = count
+  while (lo < hi) {
+    const mid = (lo + hi + 1) >> 1
+    if ((prefix[mid] ?? Infinity) <= room) lo = mid
+    else hi = mid - 1
+  }
+  return lo
+}
+
+/**
+ * The names of the frames drawn on the GPU canvas, rendered into one canvas.
+ * `build` lays out the names it is given (a name shared by several frames is
+ * one cell) and draws them; it measures a name only the first time it sees
+ * it in a font, so a rebuild for a new theme or a renamed frame only redraws.
+ */
+export class NameAtlas {
+  readonly canvas: HTMLCanvasElement
+  private ctx: CanvasRenderingContext2D
+  /** the cells by name; a name missing here did not fit (its frame stays in the DOM) */
+  cells = new Map<string, NameCell>()
+  ellipsis: NameCell | null = null
+  style: NameStyle | null = null
+  dpr = 1
+  /** bumped on every build, so the renderer knows to upload */
+  version = 0
+  private measured = new Map<string, { advance: number; prefix: Float32Array; count: number }>()
+  private measuredFont = ''
+
+  constructor() {
+    this.canvas = document.createElement('canvas')
+    this.ctx = this.canvas.getContext('2d')!
+  }
+
+  private applyFont(style: NameStyle) {
+    const ctx = this.ctx
+    ctx.font = style.font
+    ctx.letterSpacing = style.letterSpacing
+    ctx.fontKerning = 'normal'
+    ctx.textBaseline = 'alphabetic'
+    ctx.textAlign = 'left'
+  }
+
+  private measure(name: string) {
+    const known = this.measured.get(name)
+    if (known) return known
+    const ends = graphemeEnds(name)
+    const prefix = new Float32Array(ends.length + 1)
+    for (let k = 0; k < ends.length; k++) prefix[k + 1] = this.ctx.measureText(name.slice(0, ends[k])).width
+    const m = { advance: prefix[ends.length] ?? 0, prefix, count: ends.length }
+    this.measured.set(name, m)
+    return m
+  }
+
+  /** Lays out and draws `names` (no empty ones) in `style` at `dpr`. */
+  build(names: Iterable<string>, style: NameStyle, dpr: number, maxSide: number) {
+    const ctx = this.ctx
+    const font = `${style.font}|${style.letterSpacing}`
+    if (font !== this.measuredFont) {
+      this.measured.clear()
+      this.measuredFont = font
+    }
+    this.applyFont(style)
+    const side = Math.min(ATLAS_SIDE, maxSide)
+    const cellH = Math.ceil(style.lineHeight * dpr) + 2 * PAD
+    const cells = new Map<string, NameCell>()
+    let x = 0
+    let y = 0
+    const place = (name: string): NameCell | null => {
+      const m = this.measure(name)
+      const width = Math.ceil(m.advance * dpr) + 2 * PAD
+      if (width > side) return null
+      if (x + width > side) {
+        x = 0
+        y += cellH
+      }
+      if (y + cellH > side) return null
+      const cell = { x, y, width, height: cellH, ...m }
+      x += width
+      return cell
+    }
+    const ellipsis = place('…')
+    for (const name of names) {
+      if (cells.has(name)) continue
+      const cell = place(name)
+      if (cell) cells.set(name, cell)
+    }
+    const height = Math.max(1, y + cellH)
+    /* a resize clears the canvas and resets its state */
+    this.canvas.width = side
+    this.canvas.height = height
+    this.applyFont(style)
+    ctx.fillStyle = style.color
+    /* the baseline on a whole device pixel, as the DOM lays text out */
+    const base = Math.round(style.baseline * dpr)
+    const drawCell = (name: string, c: NameCell) => {
+      ctx.setTransform(dpr, 0, 0, dpr, c.x + PAD, c.y + PAD + base)
+      ctx.fillText(name, 0, 0)
+    }
+    if (ellipsis) drawCell('…', ellipsis)
+    for (const [name, c] of cells) drawCell(name, c)
+    ctx.setTransform(1, 0, 0, 1, 0, 0)
+    this.cells = cells
+    this.ellipsis = ellipsis
+    this.style = style
+    this.dpr = dpr
+    this.version++
+  }
+}
