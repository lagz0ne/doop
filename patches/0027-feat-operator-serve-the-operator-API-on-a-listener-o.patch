 # 404, token or not. For an instance whose public edge should never offer
 # /api/operator, without relying on a proxy path rule. doopctl then talks to
 # the port directly (--url http://<container or host address>:<PORT>).
+# It tells a proxied request by those headers, so it holds only behind a proxy
+# that adds one (Traefik, Caddy and Cloudflare do; nginx only with
+# proxy_set_header X-Forwarded-For). DOOP_OPERATOR_LISTEN does not depend on it.
 #DOOP_OPERATOR_DIRECT_ONLY=true
+# [host:]port = serve the operator API on a listener of its own and not on
+# PORT at all (host defaults to 127.0.0.1; 0.0.0.0:4401 for a port the host
+# reaches but the proxy is not pointed at). doopctl --url http://<that address>.
+#DOOP_OPERATOR_LISTEN=127.0.0.1:4401
 
