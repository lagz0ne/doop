# Settings for bin/doop and bin/doopctl. Copy to .env.local (git-ignored) and fill in
# what your setup needs; anything unset falls back to the default shown. The
# environment wins over the file. One KEY=value per line, no shell expansion.

# --- bin/doop release
# DOOP_FORK_REMOTE=fork            # remote in vendor/doop that releases are pushed to
# DOOP_RELEASE_SUFFIX=patched      # tags are <upstream-tag>-<suffix>.<n>
# DOOP_RELEASE_BRANCH=patched      # branch on that remote that follows the latest release
# DOOP_COMMITTER_NAME=doop-build   # fixed committer, so builds are reproducible
# DOOP_COMMITTER_EMAIL=doop-build@localhost
# DOOP_POST_RELEASE=               # command run after a release, with the tag as $1 (e.g. ask for a deploy)
# DOOP_DEPLOYED_CMD=               # command printing one line about what is deployed (bin/doop status)

# --- bin/doopctl
# DOOP_URL=http://localhost:4477   # the instance
# DOOP_CONNECT=                    # connect to this address instead of DNS (TLS and Host kept)
# DOOP_ADMIN_TOKEN_FILE=~/.config/doop/admin-token   # or DOOP_ADMIN_TOKEN in the environment
